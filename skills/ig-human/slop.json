  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)\\bit'?s not (?:just|only) [^.!?\\n]{2,60}[,.] it'?s\\b",
      "name": "«It's not just X, it's Y»",
      "fix": "Скажите то одно, что имеете в виду. Удалите подводку."
    },
    {
      "id": "not-only",
      "regex": "(?i)\\bnot only\\b[^.!?\\n]{2,80}\\bbut also\\b",
      "name": "«Not only X but also Y»",
      "fix": "Разбейте на два предложения или уберите слабую половину."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)\\b(?:this|it) is(?:n'?t| not) about [^.!?\\n]{2,60}[.!] it'?s about\\b",
      "name": "«It isn't about X. It's about Y.»",
      "fix": "Начните с Y. Разворот и есть примета."
    },
    {
      "id": "the-result",
      "regex": "(?i)^\\s*(?:the result|the best part|the kicker|the catch)\\?\\s*$",
      "name": "Строка из одного риторического вопроса (en)",
      "fix": "Ответьте сразу, без постановки «разоблачения»."
    },
    {
      "id": "heres-what",
      "regex": "(?i)\\bhere'?s what (?:i|we) learned\\b",
      "name": "«Here's what I learned»",
      "fix": "Назовите урок. Без анонса."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+, and \\w+\\.",
      "name": "Правило трёх (en)",
      "fix": "Два пункта или четыре. Три - ритм модели по умолчанию."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Эмодзи ракета / огонь / лампочка / искры / мишень",
      "fix": "Максимум один эмодзи, и не из этих пяти."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "name": "Стена хэштегов (больше 5)",
      "fix": "До пяти тегов. После пятого Instagram их не учитывает."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\bas an ai\\b|\\bas a language model\\b",
      "name": "Модель упоминает себя (en)",
      "fix": "Удалите предложение."
    },
    {
      "id": "in-summary",
      "regex": "(?i)^\\s*(?:in summary|to summarize|in conclusion)\\b",
      "name": "Сочинение: «In summary» в начале строки",
      "fix": "Посту не нужен заключительный абзац."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)\\b(?:agree\\?|thoughts\\?|who else\\b|am i wrong\\?)\\s*$",
      "name": "Рефлекторная приманка для вовлечения (en)",
      "fix": "Задайте вопрос, который можете задать только вы, про конкретную вещь выше."
    },
    {
      "id": "stop-scroll",
      "regex": "(?im)^\\s*(?:stop scrolling|don'?t scroll|wait[,.]? don'?t scroll)\\b",
      "name": "Зачин «Stop scrolling»",
      "fix": "Остановить палец должно само утверждение. Просьба о внимании выдаёт, что вы его не заработали."
    },
    {
      "id": "in-this-video",
      "regex": "(?i)\\b(?:in (?:this|today'?s) (?:video|reel|post)|today i'?m going to show you|i'?m going to (?:show|teach) you how)\\b",
      "name": "Вступление «in this video I'm going to show you»",
      "fix": "Удалите и начните с сути. Первые две секунды решают всё."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Список с эмодзи вместо маркеров",
      "fix": "Дефис или перенос строки. Эмодзи-маркеры - самое шаблонное, что бывает в подписи."
    },
    {
      "id": "caps-shout",
      "regex": "\\b[A-ZА-ЯЁ]{3,}\\b(?:\\s+\\b[A-ZА-ЯЁ]{3,}\\b){2,}",
      "name": "Три и больше слов КАПСОМ подряд",
      "fix": "Капс - это громкость, а не маркер. Максимум одно слово."
    },
    {
