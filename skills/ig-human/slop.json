      "regex": "(?i)\\b(?:follow for more|tag someone who|double tap if|share this if|comment below if)\\b",
      "name": "Рефлекторное «follow / tag / double tap» (en)",
      "fix": "Попросите одно действие, которое этот пост действительно заслужил."
    },
